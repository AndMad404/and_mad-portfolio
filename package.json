{
  "name": "and-mad-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "dev:studio": "vite --config vite.studio.config.ts --host 127.0.0.1",
    "dev:api": "tsx scripts/dev-api.ts",
    "build": "react-router build && tsx scripts/finalize-site.ts && tsx scripts/verify-build.ts",
    "build:studio": "vite build --config vite.studio.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:content && npm run test:nodes && npm run test:animations && npm run test:transitions",
    "test:content": "tsx --test tests/content.test.ts",
    "test:nodes": "tsx --test tests/nodes.test.ts",
    "test:animations": "tsx --test tests/animations.test.ts",
    "test:transitions": "tsx --test tests/transitions.test.ts",
    "test:edition:unverified": "tsx --test tests/edition/backend.unverified.ts tests/edition/connector.unverified.ts tests/edition/preview.unverified.ts",
    "db:local": "wrangler d1 migrations apply editorial --local --config wrangler.studio.jsonc",
    "connector": "tsx connector/main.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "jose": "6.2.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "miniflare@4.20260730.0": {
      "undici": "7.30.1",
      "sharp": "0.35.5"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261114.1",
    "@react-router/dev": "7.18.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "miniflare": "4.20260730.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.5",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "wrangler": "4.162.0"
  }
}
